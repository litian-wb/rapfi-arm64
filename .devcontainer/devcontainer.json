{
  "name": "Rapfi 五子棋引擎",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "forwardPorts": [8766],
  "portsAttributes": {
    "8766": {
      "label": "Rapfi 引擎",
      "visibility": "public",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "bash /workspaces/rapfi-arm64/cloud/setup.sh",
  "postStartCommand": "bash /workspaces/rapfi-arm64/cloud/boot.sh",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  }
}
